# =============================================================================
# Project configuration
# =============================================================================
# EDIT EVERY VALUE IN THIS FILE BEFORE RUNNING ANYTHING.
#
# This file is the single source of truth for paths, species, library types and
# cluster settings. It is read by the bash/sbatch scripts (via `source`) and by
# the R scripts (via 02_R/R/config.R). Keeping it in one place means you never
# have to hunt for a hard-coded path inside a script.
#
# Format rules (it is read by both bash and R, so keep it simple):
#   - one KEY=value per line, no spaces around the "="
#   - no shell expansion, no backticks, no $(...) substitutions
#   - quote values containing spaces
#   - lines starting with # are comments
# =============================================================================


# ---- Paths ------------------------------------------------------------------

# Root of this project checkout on your cluster, e.g. /scratch/mylab/me/my-project
# Everything the pipeline writes goes underneath here.
PROJECT_ROOT=/path/to/your/project

# Root of the raw sequencing delivery from your sequencing core. This is only
# ever read from, never written to. The symlink step searches this whole tree.
RAW_FASTQ_DIR=/path/to/sequencing/delivery

# Where to copy results so collaborators can see them (a web-served directory).
# Leave as-is if you do not publish results to the web; the publish step will
# simply create this directory locally.
WEB_PUBLISH_DIR=/path/to/web/publish/dir

# Public URL corresponding to WEB_PUBLISH_DIR. Used to build download links in
# the HTML reports. No trailing slash.
WEB_PUBLISH_URL=https://example.org/path/to/results


# ---- Experiment -------------------------------------------------------------

# Short project label used in report titles, output filenames and the Loupe
# file name. Keep it filesystem-safe (no spaces or slashes).
PROJECT_NAME=my_scrnaseq_project

# Longer, human-readable title shown at the top of the HTML reports.
PROJECT_TITLE="Single-cell RNA-seq Analysis"

# Species. Controls which Cell Ranger references are downloaded and which
# mitochondrial / ribosomal gene patterns and marker genes the R scripts use.
# Supported: mouse | human
SPECIES=mouse

# Library types present in this experiment, space-separated.
# The library tag must match how the library appears in your fastq filenames
# (e.g. 1-GEX_S1_L001_R1_001.fastq.gz -> tag "GEX").
#   GEX = gene expression            (required)
#   CSP = cell surface protein / feature barcoding, incl. hashtags
#   TCR = V(D)J T cell receptor
#   BCR = V(D)J B cell receptor
# The default below is the common GEX + TCR + CSP design. Add BCR if you have
# it; remove TCR or CSP if you do not. Scripts adapt automatically.
LIBRARY_TYPES="GEX CSP TCR"

# Whether the CSP library carries multiplexing hashtags that Cell Ranger should
# use to demultiplex pooled samples (true), or only surface-protein antibodies
# with no demultiplexing (false).
# When true, config/samples.tsv must have a hashtag_id for every sample.
USE_HASHTAG_DEMUX=true


# ---- Cluster / SLURM --------------------------------------------------------

# The allocation to bill jobs to. Ask your cluster administrator if unsure.
SLURM_ACCOUNT=your_slurm_account
SLURM_QOS=your_slurm_qos

# Environment module names. Change these to match what `module avail` shows on
# your cluster. If your cluster does not use environment modules, set
# USE_MODULES=false and make sure the tools are already on your PATH.
USE_MODULES=true
CELLRANGER_MODULE=cellranger/9.0.0
FASTQC_MODULE=fastqc
R_MODULE=R/4.5
PANDOC_MODULE=pandoc/2.2.2.1


# ---- Cell Ranger options ----------------------------------------------------

# Write BAM files. These are large; set to false unless you need them for
# variant calling or IGV inspection.
CREATE_BAM=false

# Resources requested for each cellranger multi job.
CELLRANGER_TIME=24:00:00
CELLRANGER_MEM=250G
CELLRANGER_CPUS=32
